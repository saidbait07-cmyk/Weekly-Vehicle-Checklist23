// Smart Vehicle Inspection & Fleet Management System (SVIFMS)
// Production PostgreSQL Schema — Al-Ghalbi International Engineering & Contracting LLC

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum VehicleStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum VehicleSafetyState {
  SAFE
  NEEDS_REVIEW
  OUT_OF_SERVICE
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  AMENDED
  FLAGGED_UNSAFE
}

enum SyncStatus {
  SYNCED
  PENDING_SYNC
  CONFLICT
  FAILED
}

enum ItemResponseValue {
  PASS
  FAIL
  NA
  NOT_CHECKED
}

enum FaultSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultWorkflowStatus {
  REPORTED
  ACKNOWLEDGED
  UNDER_REVIEW
  UNDER_MAINTENANCE
  RESOLVED
  VERIFIED_AND_CLOSED
}

// 1. departments
model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  nameEn      String
  nameAr      String
  nameHi      String
  nameUr      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  vehicles    Vehicle[]
}

// 2. roles
model Role {
  id          String       @id @default(uuid())
  code        String       @unique // ADMIN, SUPERVISOR, DRIVER
  nameEn      String
  nameAr      String
  nameHi      String
  nameUr      String
  createdAt   DateTime     @default(now())
  userRoles   UserRole[]
  permissions Permission[] @relation("RolePermissions")
}

// 3. permissions
model Permission {
  id          String     @id @default(uuid())
  flag        String     @unique // e.g., CAN_CREATE_USER, CAN_ACKNOWLEDGE_FAULT, CAN_EXPORT_ALL
  description String
  roles       Role[]     @relation("RolePermissions")
}

// 4. users
model User {
  id                   String        @id @default(uuid())
  employeeId           String        @unique // e.g., EMP00125
  fullName             String
  passwordHash         String
  mustChangePassword   Boolean       @default(true)
  failedLoginAttempts  Int           @default(0)
  lockedUntil          DateTime?
  phone                String?
  ropLicenseExpiry     DateTime?
  preferredLanguage    String        @default("en") // en, ar, hi, ur
  status               AccountStatus @default(ACTIVE)
  departmentId         String
  department           Department    @relation(fields: [departmentId], references: [id])
  assignedSupervisorId String?
  assignedSupervisor   User?         @relation("SupervisorSubordinates", fields: [assignedSupervisorId], references: [id])
  subordinates         User[]        @relation("SupervisorSubordinates")
  customPermissions    Json?         // Configurable per-user permission flag overrides
  lastLoginAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  userRoles            UserRole[]
  driverAssignments    VehicleAssignment[]           @relation("DriverAssignments")
  supervisorVehicles   SupervisorVehicleAssignment[] @relation("SupervisorAssignments")
  inspections          Inspection[]                  @relation("DriverInspections")
  reportedFaults       FaultReport[]                 @relation("FaultReporter")
  sessions             Session[]
  auditLogs            AuditLog[]
}

// 5. user_roles
model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// 6. vehicles
model Vehicle {
  id                     String             @id @default(uuid())
  vehicleCode            String             @unique // e.g., V001
  registrationNumber     String             @unique
  plateNumber            String             @unique
  vehicleCategory        String             // Light Vehicle / Heavy Vehicle (ثقيل أو خفيف)
  manufacturer           String
  model                  String
  manufacturingYear      Int
  departmentId           String
  department             Department         @relation(fields: [departmentId], references: [id])
  currentOdometerKm      Int                @default(0)
  registrationExpiryDate DateTime
  insuranceExpiryDate    DateTime
  opalStickerExpiryDate  DateTime?
  status                 VehicleStatus      @default(ACTIVE)
  safetyState            VehicleSafetyState @default(SAFE)
  qrToken                String             @unique // Opaque token for QR code lookup
  photoStorageKey        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  archivedAt             DateTime?

  driverAssignments      VehicleAssignment[]
  supervisorAssignments  SupervisorVehicleAssignment[]
  inspections            Inspection[]
  faultReports           FaultReport[]
  maintenanceRecords     MaintenanceRecord[]
  complaints             Complaint[]
}

// 7. vehicle_assignments (Enforces 1 authorized driver per vehicle per calendar date)
model VehicleAssignment {
  id             String    @id @default(uuid())
  vehicleId      String
  driverId       String
  assignmentDate DateTime  @db.Date // Local company timezone date (Asia/Muscat)
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  isEmergency    Boolean   @default(false)
  changeReason   String?
  assignedById   String
  createdAt      DateTime  @default(now())

  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  driver         User      @relation("DriverAssignments", fields: [driverId], references: [id])

  @@index([vehicleId, assignmentDate])
  @@index([driverId, assignmentDate])
}

// 8. supervisor_vehicle_assignments
model SupervisorVehicleAssignment {
  id           String    @id @default(uuid())
  vehicleId    String
  supervisorId String
  isActive     Boolean   @default(true)
  assignedById String
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?

  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  supervisor   User      @relation("SupervisorAssignments", fields: [supervisorId], references: [id])

  @@index([supervisorId, isActive])
}

// 9. checklist_templates
model ChecklistTemplate {
  id          String             @id @default(uuid())
  code        String             @unique // AL_GHALBI_WEEKLY_STD
  titleEn     String
  titleAr     String
  titleHi     String
  titleUr     String
  createdAt   DateTime           @default(now())
  versions    ChecklistVersion[]
}

// 10. checklist_versions
model ChecklistVersion {
  id            String          @id @default(uuid())
  templateId    String
  versionNumber Int             // 1, 2, 3...
  isPublished   Boolean         @default(false)
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())

  template      ChecklistTemplate @relation(fields: [templateId], references: [id])
  items         ChecklistItem[]
  inspections   Inspection[]

  @@unique([templateId, versionNumber])
}

// 11. checklist_items
model ChecklistItem {
  id                 String                     @id @default(uuid())
  versionId          String
  serialNumber       Int                        // 1..31 matching Al-Ghalbi paper form
  categoryCode       String                     // LIGHTING, MIRRORS, SAFETY, FLUIDS, TYRES, COMPLIANCE, SIGNOFF
  allowedResponses   String[]                   // ["PASS", "FAIL", "NA"]
  isRequired         Boolean                    @default(true)
  requirePhotoOnFail Boolean                    @default(false)
  isSafetyCritical   Boolean                    @default(false)
  iconName           String?
  instructionImgKey  String?
  sortOrder          Int
  isActive           Boolean                    @default(true)
  needsAdminVerify   Boolean                    @default(false)
  archivedAt         DateTime?

  version            ChecklistVersion           @relation(fields: [versionId], references: [id])
  translations       ChecklistItemTranslation[]
  responses          InspectionResponse[]
}

// 12. checklist_item_translations
model ChecklistItemTranslation {
  id              String        @id @default(uuid())
  itemId          String
  languageCode    String        // en, ar, hi, ur
  label           String
  description     String?
  verifiedByAdmin Boolean       @default(true)

  item            ChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, languageCode])
}

// 13. inspections
model Inspection {
  id                 String               @id @default(uuid())
  inspectionCode     String               @unique // e.g., INS-20261022-001
  idempotencyKey     String               @unique // Prevents duplicate offline/online submissions
  vehicleId          String
  driverId           String
  checklistVersionId String
  inspectionDate     DateTime             @db.Date // Asia/Muscat local date
  dayOfWeek          String               // Sunday..Saturday
  startingKm         Int
  closingKm          Int?
  odometerKm         Int
  ropExpiryDate      DateTime?
  driverSignature    String?
  supervisorSign     String?
  generalRemarks     String?
  defectDescription  String?              // Row 32: Defect Description
  actionTaken        String?              // Row 32: Action Taken
  status             InspectionStatus     @default(SUBMITTED)
  syncStatus         SyncStatus           @default(SYNCED)
  submittedAt        DateTime             @default(now())
  amendedAt          DateTime?
  amendmentReason    String?

  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id])
  driver             User                 @relation("DriverInspections", fields: [driverId], references: [id])
  checklistVersion   ChecklistVersion     @relation(fields: [checklistVersionId], references: [id])
  responses          InspectionResponse[]
  faultReports       FaultReport[]

  @@unique([vehicleId, driverId, inspectionDate])
  @@index([vehicleId, inspectionDate])
}

// 14. inspection_responses
model InspectionResponse {
  id              String            @id @default(uuid())
  inspectionId    String
  checklistItemId String
  response        ItemResponseValue
  remarks         String?
  createdAt       DateTime          @default(now())

  inspection      Inspection        @relation(fields: [inspectionId], references: [id])
  checklistItem   ChecklistItem     @relation(fields: [checklistItemId], references: [id])

  @@unique([inspectionId, checklistItemId])
}

// 15. fault_reports
model FaultReport {
  id                    String              @id @default(uuid())
  faultCode             String              @unique // FLT-2026-001
  vehicleId             String
  inspectionId          String?
  checklistItemSn       Int?
  reportedById          String
  category              String
  description           String
  severity              FaultSeverity
  status                FaultWorkflowStatus @default(REPORTED)
  isConfirmed           Boolean             @default(false)
  assignedSupervisorId  String?
  assignedMaintenanceTo String?
  correctiveAction      String?
  resolutionNotes       String?
  reportedAt            DateTime            @default(now())
  resolvedAt            DateTime?
  closedAt              DateTime?

  vehicle               Vehicle             @relation(fields: [vehicleId], references: [id])
  inspection            Inspection?         @relation(fields: [inspectionId], references: [id])
  reportedBy            User                @relation("FaultReporter", fields: [reportedById], references: [id])
  images                FaultImage[]
  maintenanceRecords    MaintenanceRecord[]

  @@index([vehicleId, category, reportedAt])
}

// 16. fault_images
model FaultImage {
  id            String      @id @default(uuid())
  faultReportId String
  storageKey    String
  mimeType      String
  fileSizeBytes Int
  uploadedAt    DateTime    @default(now())

  faultReport   FaultReport @relation(fields: [faultReportId], references: [id])
}

// 17. maintenance_records
model MaintenanceRecord {
  id                String       @id @default(uuid())
  maintenanceCode   String       @unique
  vehicleId         String
  faultReportId     String?
  technicianName    String
  workshopName      String?
  workDescription   String
  partsReplaced     String?
  costOmr           Decimal?     @db.Decimal(10, 3)
  odometerAtService Int
  status            String       // SCHEDULED, IN_PROGRESS, COMPLETED, VERIFIED
  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  verifiedById      String?

  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id])
  faultReport       FaultReport? @relation(fields: [faultReportId], references: [id])
}

// 18. complaints
model Complaint {
  id           String   @id @default(uuid())
  complaintNo  String   @unique
  vehicleId    String
  employeeId   String
  category     String
  description  String
  status       String   @default("OPEN")
  supervisorNotes String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
}

// 19. notifications
model Notification {
  id              String   @id @default(uuid())
  recipientUserId String
  vehicleId       String?
  type            String   // CRITICAL_FAULT, REPEATED_FAILURE, MISSING_INSPECTION, DOC_EXPIRY, SYNC_FAILED
  title           String
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead])
}

// 20. audit_logs (Immutable append-only operational trail)
model AuditLog {
  id             String   @id @default(uuid())
  actorUserId    String
  actorEmpId     String
  actionType     String   // USER_CREATE, ROLE_CHANGE, VEHICLE_ASSIGN, CHECKLIST_EDIT, INSPECTION_SUBMIT, FAULT_STATUS, EXCEL_EXPORT
  affectedTable  String
  affectedRecord String
  previousValue  Json?
  newValue       Json?
  result         String   @default("SUCCESS")
  sessionId      String?
  createdAt      DateTime @default(now())

  actor          User     @relation(fields: [actorUserId], references: [id])

  @@index([actorEmpId, createdAt])
  @@index([affectedTable, affectedRecord])
}

// 21. export_jobs
model ExportJob {
  id           String   @id @default(uuid())
  requestedBy  String
  exportScope  String   // FULL_WORKBOOK, SINGLE_VEHICLE, DATE_RANGE, SCHEDULED_SNAPSHOT
  fileName     String
  storageKey   String
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
}

// 22. backup_records
model BackupRecord {
  id              String   @id @default(uuid())
  backupType      String   // DB_FULL_DUMP, EXCEL_DAILY_SNAPSHOT, EXCEL_WEEKLY_SNAPSHOT
  fileName        String
  checksumSha256  String
  sizeBytes       BigInt
  status          String   // VERIFIED, FAILED, RESTORE_TESTED
  retentionDays   Int      @default(90)
  createdAt       DateTime @default(now())
  lastRestoreTest DateTime?
}

// 23. synchronization_jobs
model SynchronizationJob {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  employeeId     String
  deviceId       String
  payloadType    String   // OFFLINE_INSPECTION, OFFLINE_FAULT_PHOTO
  status         String   // PROCESSED, CONFLICT, REJECTED_UNAUTHORIZED
  conflictNotes  String?
  receivedAt     DateTime @default(now())
}

model Session {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
